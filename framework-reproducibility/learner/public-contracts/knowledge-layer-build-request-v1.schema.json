{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-layer-build-request-v1.schema.json",
  "title": "Knowledge Layer Build Request v1",
  "type": "object",
  "required": ["schema_version", "scope_id", "repositories", "output_path", "modes"],
  "properties": {
    "schema_version": {"const": "knowledge_layer/v1"},
    "scope_id": {"type": "string", "minLength": 1},
    "scope_type": {"enum": ["repository", "workspace"]},
    "repository_count": {"type": "integer", "minimum": 1},
    "repository_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repo_id", "repository_analysis_manifest", "static_analysis_output"],
        "properties": {
          "repo_id": {"type": "string", "minLength": 1},
          "repository_analysis_manifest": {"type": "string", "minLength": 1},
          "static_analysis_output": {"type": "string", "minLength": 1},
          "expected_analysis_fingerprint": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "output_path": {"type": "string", "minLength": 1},
    "modes": {"type": "array", "items": {"enum": ["data-model", "sql"]}, "minItems": 1, "uniqueItems": true},
    "replace": {"type": "boolean"},
    "export_jsonl": {"type": "boolean"}
  },
  "additionalProperties": false
}
