{
  "$id": "repository-topology/v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attribute_identity_policy": {
      "additionalProperties": false,
      "properties": {
        "name_comparison": {"const": "exact_case_sensitive"},
        "rename_inference": {"const": "forbidden"}
      },
      "required": ["name_comparison", "rename_inference"],
      "type": "object"
    },
    "diagnostics": {
      "items": {
        "required": [
          "kind", "repository_id", "observed_identity_id", "protocol", "direction",
          "identity_status", "identities", "reason", "candidate_count"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "matchability_analysis": {
      "additionalProperties": false,
      "properties": {
        "matching_owner": {"const": "repository_topology.matching"},
        "matching_policy": {"type": "object"},
        "summary": {
          "required": [
            "repository_count", "repository_with_half_wire_count", "repository_without_half_wire_count",
            "half_wire_count", "matched_half_wire_count", "unmatched_half_wire_count", "match_count",
            "http_half_wire_count", "http_inbound_count", "http_outbound_count",
            "http_exact_eligible_inbound_count", "http_exact_eligible_outbound_count",
            "http_probable_eligible_outbound_count", "kafka_half_wire_count", "kafka_publish_count",
            "kafka_consume_count", "kafka_exact_eligible_publish_count", "kafka_exact_eligible_consume_count"
          ],
          "type": "object"
        },
        "identity_status_counts": {"type": "array"},
        "transport_identity_kind_counts": {"type": "array"},
        "unmatched_reason_counts": {"type": "array"},
        "repository_stats": {"type": "array"}
      },
      "required": [
        "matching_owner", "matching_policy", "summary", "identity_status_counts",
        "transport_identity_kind_counts", "unmatched_reason_counts", "repository_stats"
      ],
      "type": "object"
    },
    "edges": {
      "items": {
        "properties": {
          "attribute_flows": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "attribute_names": {"items": {"type": "string"}, "type": "array"},
                "basis": {"type": "array"},
                "source_repository_id": {"type": "string"},
                "target_repository_id": {"type": "string"},
                "transport_role": {"enum": ["request", "response", "payload"]}
              },
              "required": ["transport_role", "source_repository_id", "target_repository_id", "attribute_names", "basis"],
              "type": "object"
            },
            "type": "array"
          },
          "claim_classification": {"enum": ["strongly_supported_inference", "probable_inference"]},
          "confidence": {"enum": ["high", "medium_high", "medium", "low"]},
          "match_classification": {"enum": ["exact", "probable"]}
        },
        "required": [
          "edge_id", "protocol", "source_repository_id", "target_repository_id",
          "match_classification", "claim_classification", "confidence",
          "source_half_wires", "target_half_wires", "attribute_flows", "basis"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "format": {"const": "repository-topology/v3"},
    "inputs": {
      "items": {
        "required": ["repository_id", "artifact_format", "artifact_id", "semantic_fingerprint", "sha256"],
        "type": "object"
      },
      "type": "array"
    },
    "islands": {
      "items": {"required": ["island_id", "repository_ids", "edge_ids"], "type": "object"},
      "type": "array"
    },
    "repositories": {
      "items": {"required": ["repository_id", "input_ref"], "type": "object"},
      "type": "array"
    },
    "summary": {
      "required": [
        "repository_count", "edge_count", "exact_edge_count", "probable_edge_count", "island_count",
        "half_wire_count", "matched_half_wire_count", "unmatched_half_wire_count",
        "repository_with_half_wire_count", "repository_without_half_wire_count"
      ],
      "type": "object"
    },
    "topology_id": {"minLength": 1, "type": "string"}
  },
  "required": [
    "format", "topology_id", "inputs", "repositories", "edges", "islands",
    "diagnostics", "matchability_analysis", "attribute_identity_policy", "summary"
  ],
  "type": "object"
}
